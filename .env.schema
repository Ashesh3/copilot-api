# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ---

# 1Password service account token
# @type=opServiceAccountToken @sensitive
OP_TOKEN=

# 1Password environment ID to load secrets from
# @optional
OP_ENV_ID=

# --- GitHub Authentication ---

# GitHub token (optional — if omitted, uses device auth flow)
# @optional @sensitive
# GH_TOKEN=

# Multiple GitHub tokens for load balancing (comma-separated)
# When set, requests are round-robin distributed across accounts.
# @optional @sensitive
# GITHUB_TOKENS=

# --- Server Configuration ---

# Port to listen on
# @optional @type=number
# COPILOT_PORT=4141

# Bind host (use 0.0.0.0 inside Docker)
# @optional
COPILOT_HOST=0.0.0.0

# --- Security ---

# API key authentication — requests without this key are dropped
# @optional @sensitive
COPILOT_API_KEY_AUTH=

# --- Integrations ---

# Sentry error monitoring DSN
# @optional @sensitive
SENTRY_DSN=

# Groq API key for voice transcription (Whisper STT)
# @optional @sensitive
GROQ_API_KEY=

# --- Data Storage ---

# Custom data directory (defaults to ~/.local/share/copilot-api)
# @optional
# DATA_DIR=

# --- Debugging ---

# Enable verbose logging
# @optional @type=boolean
# COPILOT_VERBOSE=

# Enable debug request logging
# @optional @type=boolean
# COPILOT_DEBUG=

# --- SSL / Proxy ---

# Disable SSL certificate verification (for corporate proxies)
# @optional @type=boolean
# NODE_TLS_REJECT_UNAUTHORIZED=

# Certificate directory for HTTPS proxy
# @optional
# CERT_DIR=
