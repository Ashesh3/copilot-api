# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ---

# 1Password service account token
# @type=opServiceAccountToken @sensitive
OP_TOKEN=

# 1Password environment ID to load secrets from
# @optional
OP_ENV_ID=

# --- GitHub Authentication ---

# GitHub token (optional — if omitted, uses device auth flow)
# @optional @sensitive
GH_TOKEN=

# Multiple GitHub tokens (comma-separated)
# Two or more enable model-aware account routing, session affinity, and
# upstream-account failover. This is not unrestricted round-robin load balancing.
# @optional @sensitive
GITHUB_TOKENS=

# Copilot integration identifier assigned to this deployment.
# Defaults to vscode-chat for backwards-compatible entitlement behavior.
COPILOT_INTEGRATION_ID=

# --- Server Configuration ---

# Bind host (use 0.0.0.0 inside Docker)
# @optional
COPILOT_HOST=0.0.0.0

# --- Security ---

# Gateway authentication key. When --api-key-auth is enabled, missing or
# invalid credentials receive a uniform, no-store 401 response.
# @optional @sensitive
COPILOT_API_KEY_AUTH=

# Precomputed Argon2id PHC string for the administrator password. When set,
# this is authoritative and the dashboard cannot change the password locally.
# @optional @sensitive
COPILOT_ADMIN_PASSWORD_HASH=

# Comma-separated CIDRs for reverse proxies whose forwarding headers may be
# trusted. The Bun socket peer must fall inside one of these ranges.
# @optional
COPILOT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Exact external dashboard origin used for CSRF Origin validation
# @optional
COPILOT_ADMIN_ORIGIN=

# Experimental Direct Connect routes (disabled unless explicitly true)
# @optional @type=boolean
COPILOT_API_ENABLE_DIRECT_CONNECT=false

# Optional exact browser origins for inference-only CORS (comma-separated)
# @optional
COPILOT_INFERENCE_CORS_ORIGINS=

# Optional exact Origin accepted when a browser supplies Origin on the Claude
# voice WebSocket. Native clients that omit Origin remain supported.
# @optional
COPILOT_VOICE_ORIGIN=

# --- Integrations ---

# Sentry error monitoring DSN
# @optional @sensitive
SENTRY_DSN=

# Sentry traces sample rate (0.0 to 1.0, default 1.0 when SENTRY_DSN is set)
# @optional @type=number
SENTRY_TRACES_SAMPLE_RATE=

# Record AI prompt inputs/outputs in Sentry spans (default "true")
# Set to "false" to prevent gen_ai.request.messages and gen_ai.response.text from being sent
# @optional @type=boolean
SENTRY_AI_RECORD_INPUTS=

# Groq API key for voice transcription (Whisper STT)
# @optional @sensitive
GROQ_API_KEY=

# --- Data Storage ---

# Custom data directory (defaults to ~/.local/share/copilot-api)
# @optional
DATA_DIR=

# --- Debugging ---

# Enable verbose logging
# @optional @type=boolean
COPILOT_VERBOSE=

# Enable debug request logging
# @optional @type=boolean
COPILOT_DEBUG=

# --- SSL / Proxy ---

# Set to 0 to disable outbound SSL certificate verification process-wide
# (unsafe outside controlled debugging)
# @optional
NODE_TLS_REJECT_UNAUTHORIZED=

# Certificate directory for HTTPS proxy
# @optional
CERT_DIR=
