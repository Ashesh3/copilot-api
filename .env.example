# GitHub token (optional — if omitted, uses device auth flow with persistent volume)
# GH_TOKEN=

# Sentry error monitoring (optional)
SENTRY_DSN=

# API key authentication (optional — requests without this key are dropped)
COPILOT_API_KEY_AUTH=

# Bind host (use 0.0.0.0 inside Docker)
COPILOT_HOST=0.0.0.0

# Enable verbose logging (optional)
# COPILOT_VERBOSE=true

# Enable debug request logging (optional)
# COPILOT_DEBUG=true
