# Copy to .env and fill in deployment-specific values.
# Bun loads .env for local commands; Docker Compose passes it into the container.
# Accounts, gateway keys and provider credentials are managed in the dashboard.

# Persistence uses Bun's built-in SQLite in the local data directory.
# Docker Compose mounts the database and its sidecars at /app/data.

COPILOT_INTEGRATION_ID=copilot-developer-cli

# Docker entrypoint settings. Use --host 127.0.0.1 for a loopback-only local CLI.
COPILOT_HOST=0.0.0.0
COPILOT_VERBOSE=false
COPILOT_DEBUG=false

# Use the exact external dashboard origin and trusted reverse-proxy peer CIDRs.
COPILOT_ADMIN_ORIGIN=
COPILOT_PUBLIC_BASE_URL=
COPILOT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
COPILOT_API_ENABLE_DIRECT_CONNECT=false
COPILOT_INFERENCE_CORS_ORIGINS=
COPILOT_VOICE_ORIGIN=

# Optional telemetry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_AI_RECORD_INPUTS=false

# Optional local CLI database directory. The tracked Compose service fixes
# DATA_DIR=/app/data so the database stays inside its mounted SQLite volume.
# DATA_DIR=/absolute/local/data-directory

# Optional certificate directory for the HTTPS proxy helper.
CERT_DIR=
