# Codex Desktop dictation domain spoofing.
#
# Codex Desktop's renderer attaches `X-OpenAI-Attach-Auth` / `X-OpenAI-Attach-Integrity-State`
# headers to ALL fetches, and the main process refuses to forward them unless
# the host matches its built-in `isDesktopAuthAllowedUrl` allowlist
# (`localhost`, `*.openai.com`, `*.chatgpt.com` minus `ab.`). Pointing
# `CODEX_API_BASE_URL` at a plain custom hostname therefore breaks dictation
# (`/transcribe`) and transcript cleanup (`/codex/responses`) with a
# silent client-side `Refusing to attach … to non-OpenAI URL` throw, surfaced
# as the "Unable to transcribe audio" toast.
#
# Workaround: spoof an `*.openai.com` hostname locally — pin it to this
# gateway via DNS or `/etc/hosts`, terminate TLS here with a cert signed by
# a CA the client trusts, and proxy to copilot-api on :4141. Current Desktop
# builds do not reliably produce an API-key bearer for `/transcribe`, so that
# exact route uses the application's managed/session IP allowlist.
# `/codex/responses` remains bearer-authenticated.
#
# Set on the client:
#   CODEX_API_BASE_URL=https://{{CODEX_DESKTOP_SPOOF_PRIMARY_HOST}}
#
# Placeholders (substitute when rendering):
#   {{CODEX_DESKTOP_SPOOF_PRIMARY_HOST}}  e.g. voice.openai.com
#   {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}}  e.g. voice.openai.com codex.openai.com gateway.openai.com
#   {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_PATH}}      e.g. /root/certs/openai-spoof.crt
#   {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_KEY_PATH}}  e.g. /root/certs/openai-spoof.key
#   {{UPSTREAM_URL}}                       e.g. http://localhost:4141

server {
  listen 80;
  server_name {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}};

  client_max_body_size 0;
  client_header_timeout 2147483647s;
  client_body_timeout 2147483647s;
  proxy_connect_timeout 75s;
  proxy_send_timeout 2147483647s;
  proxy_read_timeout 2147483647s;
  send_timeout 2147483647s;

  ssl_certificate     {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_PATH}};
  ssl_certificate_key {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_KEY_PATH}};

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /transcribe {
    limit_except POST { deny all; }
    # The application authorizes this exact compatibility route by its resolved
    # managed/session-allowlisted client IP. Nginx overwrites forwarding headers
    # above so clients cannot choose the address evaluated by the application.
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    chunked_transfer_encoding on;
  }

  location = /codex/responses {
    limit_except POST { deny all; }
    if ($http_authorization = "") { return 404; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location / { return 404; }
}
