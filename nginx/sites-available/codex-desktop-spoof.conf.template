# Codex Desktop dictation domain spoofing.
# The root update.sh does not install or reload this host configuration; render
# and deploy it separately, then validate with nginx -t and inspect nginx -T.
#
# Codex Desktop's renderer attaches `X-OpenAI-Attach-Auth` / `X-OpenAI-Attach-Integrity-State`
# headers to ALL fetches, and the main process refuses to forward them unless
# the host matches its built-in `isDesktopAuthAllowedUrl` allowlist
# (`localhost`, `*.openai.com`, `*.chatgpt.com` minus `ab.`). Pointing
# `CODEX_API_BASE_URL` at a plain custom hostname therefore breaks dictation
# (`/transcribe`) and transcript cleanup (`/codex/responses`) with a
# silent client-side `Refusing to attach … to non-OpenAI URL` throw, surfaced
# as the "Unable to transcribe audio" toast.
#
# Workaround: spoof an `*.openai.com` hostname locally — pin it to this
# gateway via DNS or `/etc/hosts`, terminate TLS here with a cert signed by
# a CA the client trusts, and proxy to copilot-api on :4141. `/transcribe`
# accepts a valid inference credential and retains the application's
# managed/session IP fallback for Desktop builds that omit credentials.
# `/codex/responses` remains credential-authenticated.
#
# Set in the client's root-level `%USERPROFILE%\.codex\config.toml`:
#   chatgpt_base_url = "https://codex-gateway.openai.com"
#
# Add the same name to the client's hosts file, mapped to this gateway. Set this
# environment variable too when using the dictation and transcript-cleanup
# compatibility routes:
#   CODEX_API_BASE_URL=https://{{CODEX_DESKTOP_SPOOF_PRIMARY_HOST}}
#
# Placeholders (substitute when rendering):
#   {{CODEX_DESKTOP_SPOOF_PRIMARY_HOST}}  e.g. codex-gateway.openai.com
#   {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}}  e.g. codex-gateway.openai.com
#   {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_PATH}}      e.g. /root/certs/openai-spoof.crt
#   {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_KEY_PATH}}  e.g. /root/certs/openai-spoof.key
#   {{UPSTREAM_URL}}                       e.g. http://localhost:4141

server {
  listen 80;
  server_name {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{CODEX_DESKTOP_SPOOF_SERVER_NAMES}};

  client_max_body_size 0;
  client_header_timeout 2147483647s;
  client_body_timeout 2147483647s;
  proxy_connect_timeout 75s;
  proxy_send_timeout 2147483647s;
  proxy_read_timeout 2147483647s;
  send_timeout 2147483647s;

  ssl_certificate     {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_PATH}};
  ssl_certificate_key {{CODEX_DESKTOP_SPOOF_SSL_CERTIFICATE_KEY_PATH}};

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /transcribe {
    limit_except POST { deny all; }
    # The application accepts a valid inference credential and otherwise uses
    # its managed/session IP fallback. Nginx overwrites forwarding headers so
    # clients cannot choose the address evaluated by that fallback.
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
  }

  location = /codex/responses {
    limit_except POST { deny all; }
    if ($http_authorization = "") { return 404; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;

    # SSE route: nginx buffers responses by default, which would hold back the
    # keep-alive comment frames this route emits during long upstream waits and
    # let Cloudflare's origin inactivity timer fire anyway.
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  # OAuth refresh endpoint selected through
  # CODEX_REFRESH_TOKEN_URL_OVERRIDE. It carries no Authorization header, so
  # the application validates the versioned local refresh token itself.
  location = /v1/codex/auth/refresh {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
  }

  # OPTIONAL: Codex Computer Use URL-policy compatibility. This is not required
  # for managed authentication. If retained, the operator explicitly accepts
  # that this local-testing route allows every HTTP(S) browser URL and the app
  # emits `x-codex-browser-use-security-mode: disabled-for-local-testing`.
  # Remove this exact location from managed-auth-only rendered configurations.
  location = /backend-api/aura/site_status {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  # Keep unsupported ChatGPT-hosted services on the local gateway. Never replace
  # this default denial with a catch-all proxy to the real service.
  location / { return 404; }
}
