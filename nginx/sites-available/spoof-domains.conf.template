server {
  listen 80;
  server_name {{SPOOF_SERVER_NAMES}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{SPOOF_SERVER_NAMES}};

  ssl_certificate     {{SPOOF_SSL_CERTIFICATE_PATH}};
  ssl_certificate_key {{SPOOF_SSL_CERTIFICATE_KEY_PATH}};

  limit_req zone={{RATE_LIMIT_ZONE}} burst={{RATE_LIMIT_BURST}} nodelay;

  location / {
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    include {{PROXY_LIMITS_SNIPPET_PATH}};
    chunked_transfer_encoding on;
  }
}
