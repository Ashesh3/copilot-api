map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Public API/dashboard hostname template.
# Required placeholders are documented in ../README.md. Keep both maps in the
# nginx http context (a file under sites-enabled is normally included there).

# Normal Responses API calls use POST. Codex Desktop's Responses WebSocket
# transport uses an authenticated GET upgrade on the same paths. Reject plain
# GET requests at nginx while allowing the application to authenticate real
# WebSocket upgrades.
map "$request_method:$http_upgrade" $responses_route_allowed {
  default 0;
  ~^POST: 1;
  ~*^GET:websocket$ 1;
}

server {
  listen 80;
  server_name {{PUBLIC_SERVER_NAME}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{PUBLIC_SERVER_NAME}};

  client_max_body_size 0;

  ssl_certificate     {{PUBLIC_SSL_CERTIFICATE_PATH}};
  ssl_certificate_key {{PUBLIC_SSL_CERTIFICATE_KEY_PATH}};

  # Apply baseline browser hardening even to nginx-generated 4xx responses.
  # Application HTML supplies its own nonce-based Content-Security-Policy.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  proxy_hide_header Strict-Transport-Security;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header X-Frame-Options;
  proxy_hide_header Referrer-Policy;
  proxy_hide_header Permissions-Policy;

  # Trust CF-Connecting-IP only after nginx has verified the TCP peer against
  # Cloudflare's exact published ranges in this snippet.
  include {{CLOUDFLARE_REAL_IP_SNIPPET_PATH}};

  if ($host != "{{PUBLIC_SERVER_NAME}}") { return 444; }

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  # This template intentionally has no catch-all proxy. Add only routes that
  # the public hostname is expected to serve.
  location = /health/health {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/(?:v1/)?models/?$ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  # Keep request and response buffering disabled for generation streams.
  location ~ ^/(?:v1/)?(?:chat/completions|messages)/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location ~ ^/(?:v1/)?(?:embeddings|responses/compact)/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/(?:v1/)?responses/?$ {
    limit_except GET POST { deny all; }
    if ($responses_route_allowed = 0) { return 404; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location ~ ^/v1/messages/count_tokens/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/oauth/(?:authorize|code/(?:success|callback))/?$ {
    limit_except GET POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /v1/oauth/revoke {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /v1/oauth/token {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /dashboard {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/dashboard/(?:auth|api)(?:/.*)?$ {
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location = /remote {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/code(?:/[^/]+)?$ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/ws/remote/ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection upgrade;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location / { return 404; }
}
