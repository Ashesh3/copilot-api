map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Public API/dashboard hostname template.
# Required placeholders are documented in ../README.md. Keep both maps in the
# nginx http context (a file under sites-enabled is normally included there).
# The root update.sh does not install or reload this host configuration; render
# and deploy it separately, then validate with nginx -t and inspect nginx -T.

# Normal Responses API calls use POST. Codex Desktop's Responses WebSocket
# transport uses an authenticated GET upgrade on the same paths. Reject plain
# GET requests at nginx while allowing the application to authenticate real
# WebSocket upgrades.
map "$request_method:$http_upgrade" $responses_route_allowed {
  default 0;
  ~^POST: 1;
  ~*^GET:websocket$ 1;
}

server {
  listen 80;
  server_name {{PUBLIC_SERVER_NAME}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name {{PUBLIC_SERVER_NAME}};

  client_max_body_size 0;
  client_header_timeout 2147483647s;
  client_body_timeout 2147483647s;
  proxy_connect_timeout 75s;
  proxy_send_timeout 2147483647s;
  proxy_read_timeout 2147483647s;
  send_timeout 2147483647s;

  ssl_certificate     {{PUBLIC_SSL_CERTIFICATE_PATH}};
  ssl_certificate_key {{PUBLIC_SSL_CERTIFICATE_KEY_PATH}};

  # Apply baseline browser hardening even to nginx-generated 4xx responses.
  # Application HTML supplies its own nonce-based Content-Security-Policy.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  proxy_hide_header Strict-Transport-Security;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header X-Frame-Options;
  proxy_hide_header Referrer-Policy;
  proxy_hide_header Permissions-Policy;

  # Trust CF-Connecting-IP only after nginx has verified the TCP peer against
  # Cloudflare's exact published ranges in this snippet.
  include {{CLOUDFLARE_REAL_IP_SNIPPET_PATH}};

  if ($host != "{{PUBLIC_SERVER_NAME}}") { return 444; }

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  # This template intentionally has no catch-all proxy. Add only routes that
  # the public hostname is expected to serve.
  location = /health/health {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/(?:v1/)?models/?$ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  # Keep request and response buffering disabled for generation streams.
  location ~ ^/(?:v1/)?(?:chat/completions|messages)/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location ~ ^/(?:v1/)?(?:embeddings|responses/compact)/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /v1/audio/transcriptions {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
  }

  # Codex Desktop posts recorded composer dictation to this compatibility
  # route after its streaming transcription attempt falls back. The
  # application accepts a valid inference credential and retains its
  # managed/session transcription IP allowlist for older clients.
  location = /transcribe {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
  }

  # Codex Desktop's standalone web.run tool uses the typed alpha/search API
  # instead of embedding a hosted web_search tool in a Responses request.
  location ~ ^/(?:v1/)?alpha/search/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/(?:v1/)?responses/?$ {
    limit_except GET POST { deny all; }
    if ($responses_route_allowed = 0) { return 404; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location ~ ^/v1/messages/count_tokens/?$ {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/oauth/(?:authorize|code/(?:success|callback))/?$ {
    limit_except GET POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /v1/oauth/revoke {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location = /v1/oauth/token {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  # Current Codex Desktop builds proactively refresh ChatGPT-shaped auth.
  # This exact compatibility route accepts only the versioned local refresh
  # token generated by the tracked Windows script and validates its JWT against
  # the enabled managed trusted-digest registry.
  location = /v1/codex/auth/refresh {
    limit_except POST { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_request_buffering off;
  }

  # Read-only Codex plugin-service compatibility for managed Desktop clients.
  # The application validates the local managed bearer and never forwards it to
  # ChatGPT; account-scoped cloud catalogs return empty JSON contracts.
  location ~ ^/ps/plugins/(?:home|list|search|installed|suggested/codex|workspace/(?:created|shared))$ {
    limit_except GET { deny all; }
    if ($http_authorization = "") { return 404; }
    # Search terms and page cursors are user data; do not retain the raw query
    # string in the default Nginx access log.
    access_log off;
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location ~ "^/ps/plugins/(?:plugins_[0-9a-f]{32}|(?:plugins~)?Plugin_[0-9a-f]{32}|plugin_[A-Za-z0-9][A-Za-z0-9_-]{0,247})$" {
    limit_except GET { deny all; }
    if ($http_authorization = "") { return 404; }
    access_log off;
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location ~ ^/ps/plugin-categories/[a-z0-9]+(?:-[a-z0-9]+)*/plugins$ {
    limit_except GET { deny all; }
    if ($http_authorization = "") { return 404; }
    access_log off;
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location = /dashboard {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/dashboard/(?:auth|api)(?:/.*)?$ {
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
  }

  location = /remote {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/code(?:/[^/]+)?$ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
  }

  location ~ ^/ws/remote/ {
    limit_except GET { deny all; }
    proxy_pass {{UPSTREAM_URL}};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection upgrade;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
  }

  location / { return 404; }
}
