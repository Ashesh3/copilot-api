map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
   listen 80;
   server_name {{PUBLIC_SERVER_NAME}};
   return 301 https://$host$request_uri;
}

server {
   listen 443 ssl;
   server_name {{PUBLIC_SERVER_NAME}};

   ssl_certificate     {{PUBLIC_SSL_CERTIFICATE_PATH}};
   ssl_certificate_key {{PUBLIC_SSL_CERTIFICATE_KEY_PATH}};

   if ($host != "{{PUBLIC_SERVER_NAME}}") { return 444; }

   limit_req zone={{RATE_LIMIT_ZONE}} burst={{RATE_LIMIT_BURST}} nodelay;

   location / {
     proxy_pass {{UPSTREAM_URL}};
     proxy_http_version 1.1;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $remote_addr;
     proxy_set_header X-Forwarded-Proto $scheme;

     proxy_set_header Upgrade $http_upgrade;
     proxy_set_header Connection $connection_upgrade;

     include {{PROXY_LIMITS_SNIPPET_PATH}};
     chunked_transfer_encoding on;
   }
}
